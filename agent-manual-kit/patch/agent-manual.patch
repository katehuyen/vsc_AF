diff --git a/src/core/manualBrief.ts b/src/core/manualBrief.ts
new file mode 100644
index 0000000..258565a
--- /dev/null
+++ b/src/core/manualBrief.ts
@@ -0,0 +1,153 @@
+/**
+ * X-536 — `farm.brief`: EVERYTHING AN AGENT SHOULD KNOW ABOUT ITS SITUATION, IN ONE CALL.
+ *
+ * Who it is (session, agent, project, account), what waits for it (answered
+ * questions, queue items, A2A), what the fleet is doing, which engines can run,
+ * whether automations are live, and which language the user reads. Composed
+ * from the PUBLIC ops through the registry — no second path into any store —
+ * each under a short timeout, so one slow op costs a line, never the brief.
+ */
+
+import type { BridgeCaller, BridgeOutcome } from './bridge';
+
+export interface BriefDeps {
+    dispatch: (op: string, args: Record<string, unknown>, from?: BridgeCaller) => Promise<BridgeOutcome>;
+    version: string;
+    /** the language the user reads, as a BCP-47-ish tag ("en", "tr", "de") */
+    userLanguage: () => string;
+    /** the command agents should type */
+    command: () => string;
+    timeoutMs?: number;
+}
+
+type Dict = Record<string, unknown>;
+
+const arr = (v: unknown): Dict[] => Array.isArray(v) ? v as Dict[] : Array.isArray((v as Dict)?.rows) ? (v as Dict).rows as Dict[] : [];
+const s = (v: unknown): string => typeof v === 'string' ? v : typeof v === 'number' ? String(v) : '';
+
+async function call(deps: BriefDeps, op: string, args: Dict, from?: BridgeCaller): Promise<unknown> {
+    const ms = deps.timeoutMs ?? 4000;
+    let timer: NodeJS.Timeout | undefined;
+    try {
+        const out = await Promise.race([
+            deps.dispatch(op, args, from),
+            new Promise<BridgeOutcome>(res => { timer = setTimeout(() => res({ ok: false, error: 'timeout' }), ms); })
+        ]);
+        return out.ok ? out.result : undefined;
+    } catch { return undefined; } finally { if (timer) { clearTimeout(timer); } }
+}
+
+/** The agent whose folder holds `cwd` — a hint, said as one, never an identity. */
+function agentByFolder(agents: Dict[], cwd: string): string {
+    const norm = (p: string) => p.replace(/\\/g, '/').replace(/\/+$/, '').toLowerCase();
+    const c = norm(cwd);
+    const hit = agents.filter(a => s(a.dir) && (c === norm(s(a.dir)) || c.startsWith(norm(s(a.dir)) + '/')))
+        .sort((a, b) => s(b.dir).length - s(a.dir).length)[0];
+    return hit ? s(hit.name) : '';
+}
+
+export async function composeBrief(deps: BriefDeps, args: Dict, from?: BridgeCaller): Promise<{ data: Dict; text: string }> {
+    const who = (await call(deps, 'sessions.whoami', {}, from)) as Dict | undefined;
+    const card = (who?.card ?? undefined) as Dict | undefined;
+    const agentsP = call(deps, 'agents.list', {});
+    const agents = arr(await agentsP);
+    let agent = s(args.agent) || s(card?.agent);
+    let agentFrom = s(args.agent) ? 'argument' : agent ? 'console card' : '';
+    if (!agent && s(who?.cwd)) {
+        agent = agentByFolder(agents, s(who?.cwd));
+        if (agent) { agentFrom = 'folder (a hint: pass agent=<name> to be exact)'; }
+    }
+    const [now, gate, project, engines, questions, answered, mine, a2a] = await Promise.all([
+        call(deps, 'now.get', {}),
+        call(deps, 'automations.status', { windowDays: 1 }),
+        call(deps, 'projects.current', {}),
+        call(deps, 'engines.status', {}),
+        agent ? call(deps, 'notices.list', { agent, type: 'question', handled: false }) : undefined,
+        agent ? call(deps, 'queue.list', { sourceNoticeAgent: agent, active: true }) : undefined,
+        agent ? call(deps, 'queue.list', { target: agent, active: true }) : undefined,
+        agent ? call(deps, 'a2a.status', { agent }, from) : undefined
+    ]) as [Dict | undefined, Dict | undefined, Dict | undefined, Dict | undefined, unknown, unknown, unknown, Dict | undefined];
+
+    const running = arr(now?.running);
+    const waitingYou = arr(now?.waiting);
+    const quotas = arr((now?.today as Dict | undefined)?.quotas);
+    const engineRows = arr(engines?.engines);
+    const ready = engineRows.filter(e => e.ready).map(e => s(e.id));
+    const notReady = engineRows.filter(e => !e.ready).map(e => s(e.id));
+    const gateRow = (gate?.gate ?? {}) as Dict;
+    const data: Dict = {
+        version: deps.version,
+        command: deps.command(),
+        you: {
+            sessionId: s(who?.sessionId) || null,
+            identifiedBy: s(who?.source) || null,
+            agent: agent || null,
+            agentFrom: agentFrom || null,
+            engine: s(card?.engine) || null,
+            account: s(card?.account) || null,
+            consoleCard: s(card?.id) || null,
+            projectId: s(card?.projectId) || null
+        },
+        userLanguage: deps.userLanguage(),
+        windowProject: project && s(project.name) ? { id: s(project.id), name: s(project.name) } : null,
+        waitingForYou: agent ? {
+            openQuestions: arr(questions).length,
+            answeredIntoQueue: arr(answered).length,
+            queueItems: arr(mine).length,
+            a2aUnreadNotes: Number(a2a?.unreadNotes ?? 0),
+            a2aClaimable: Number(a2a?.claimable ?? 0),
+            a2aHeld: arr(a2a?.held).length
+        } : null,
+        fleet: {
+            agents: agents.map(a => s(a.name)),
+            runningConsole: running.length,
+            needsUser: waitingYou.length + Number(now?.waitingMore ?? 0),
+            todayCostUSD: Number((now?.today as Dict | undefined)?.cost ?? 0),
+            quotas: quotas.map(q => ({ account: s(q.account), engine: s(q.engine), percent: Number(q.percent) }))
+        },
+        automations: gateRow.blocked ? { blocked: true, kind: s(gateRow.kind), reason: s(gateRow.reason) } : { blocked: false },
+        engines: { ready, notReady }
+    };
+    return { data, text: renderBrief(data) };
+}
+
+export function renderBrief(d: Dict): string {
+    const you = d.you as Dict;
+    const w = d.waitingForYou as Dict | null;
+    const f = d.fleet as Dict;
+    const eng = d.engines as Dict;
+    const auto = d.automations as Dict;
+    const lines: string[] = [`# Brief: Agent Farm ${s(d.version)}`];
+    const youBits = [
+        you.sessionId ? `session ${s(you.sessionId).slice(0, 8)} (from ${s(you.identifiedBy)})` : 'session unknown (your engine published no id; pass session=<id> to ops that need it)',
+        you.agent ? `agent ${s(you.agent)} (from ${s(you.agentFrom)})` : 'agent unknown (pass agent=<name>)',
+        you.engine ? `engine ${s(you.engine)}` : '',
+        you.account ? `account ${s(you.account)}` : '',
+        you.projectId ? `project ${s(you.projectId)}` : ''
+    ].filter(Boolean);
+    lines.push(`You: ${youBits.join(' · ')}`);
+    lines.push(`User language: ${s(d.userLanguage) || 'unknown'}. Write what the user reads (notices, reports, replies) in it; `
+        + 'system files and agent-to-agent text in English.');
+    if (d.windowProject) { lines.push(`Active project in the window: ${s((d.windowProject as Dict).name)}`); }
+    if (w) {
+        const items = [
+            w.openQuestions ? `${w.openQuestions} open question(s) you asked` : '',
+            w.answeredIntoQueue ? `${w.answeredIntoQueue} answered notice(s) in the queue for you` : '',
+            w.queueItems ? `${w.queueItems} queue item(s) routed to you` : '',
+            w.a2aUnreadNotes ? `${w.a2aUnreadNotes} unread A2A note(s)` : '',
+            w.a2aHeld ? `${w.a2aHeld} A2A task(s) you hold` : '',
+            w.a2aClaimable ? `${w.a2aClaimable} A2A task(s) you could claim` : ''
+        ].filter(Boolean);
+        lines.push(items.length ? `Waiting for you: ${items.join(' · ')} → \`farm.guide id=check-inbox\`` : 'Waiting for you: nothing.');
+    }
+    const quota = (f.quotas as Dict[]).slice(0, 4).map(q => `${s(q.account)} ${s(q.engine)} ${s(q.percent)}%`).join(', ');
+    lines.push(`Fleet: ${(f.agents as string[]).length} agents · ${s(f.runningConsole)} Console session(s) running · `
+        + `${s(f.needsUser)} item(s) need the user · today $${Number(f.todayCostUSD).toFixed(2)}`
+        + (quota ? ` · 5-hour quota: ${quota}` : ''));
+    lines.push(`Agents: ${(f.agents as string[]).join(', ') || 'none found'}`);
+    lines.push(`Engines ready: ${(eng.ready as string[]).join(', ') || 'none'}`
+        + ((eng.notReady as string[]).length ? ` (not ready: ${(eng.notReady as string[]).join(', ')}; \`engines.status\`)` : ''));
+    lines.push(auto.blocked ? `Automations: HELD (${s(auto.kind)}: ${s(auto.reason)})` : 'Automations: live');
+    lines.push('', `Next: \`farm.find q="<the user's request>"\` · \`farm.guide\` (map) · details: \`now.get\`, \`farm.waits\`, \`tasks.list\`.`);
+    return lines.join('\n');
+}
diff --git a/src/core/manualBuild.ts b/src/core/manualBuild.ts
new file mode 100644
index 0000000..ea530c7
--- /dev/null
+++ b/src/core/manualBuild.ts
@@ -0,0 +1,94 @@
+/**
+ * X-536 — COMPILE THE MANUAL AGAINST THE BUILD THAT IS RUNNING.
+ *
+ * The registry is the truth about which ops exist; `ops.meta.json` is the
+ * truth about how to talk about them. Joined here, every registered op gets a
+ * contract page — including one nobody has described yet, whose area and
+ * summary are DERIVED (and marked `derived`) rather than left out: an agent
+ * must never meet an op the manual pretends not to know. The tests forbid a
+ * derived entry in a release (test/test_manual_content.js), so the fallback
+ * exists for the window between registering an op and describing it.
+ *
+ * Pure: the caller hands in the source, the catalog and the version.
+ */
+
+import { CompiledManual, ManualOp, MANUAL_SCHEMA } from '../service/manualQuery';
+import { ManualSource } from './manualSource';
+
+export interface CatalogRow { op: string; describe: string }
+
+export interface ManualBuild {
+    manual: CompiledManual;
+    /** source problems plus ops with derived metadata and metadata for ops that do not exist */
+    problems: string[];
+}
+
+/** The first sentence of a contract, with the developer's ticket ids and shouting taken out. */
+export function derivedSummary(describe: string): string {
+    const clean = String(describe ?? '')
+        .replace(/‼️/g, '')
+        .replace(/\b[A-Z]{1,3}-\d{1,4}\b\s*[—-]?\s*/g, '')
+        .replace(/\s+/g, ' ')
+        .trim();
+    const first = /^(.{20,220}?[.!?])(\s|$)/.exec(clean)?.[1] ?? clean.slice(0, 160);
+    // A sentence written in capitals for emphasis reads as shouting to a model.
+    return first === first.toUpperCase() ? first.charAt(0) + first.slice(1).toLowerCase() : first;
+}
+
+/** Ops whose area is not curated land in the area their namespace mostly belongs to. */
+function guessArea(op: string, meta: ManualSource['meta']): string {
+    const ns = op.split('.')[0];
+    const counts = new Map<string, number>();
+    for (const [name, m] of Object.entries(meta)) {
+        if (name.split('.')[0] === ns) { counts.set(m.area, (counts.get(m.area) ?? 0) + 1); }
+    }
+    return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? 'basics';
+}
+
+function guessEffect(op: string): ManualOp['effect'] {
+    const verb = op.split('.').pop() ?? '';
+    if (/^(list|get|status|find|read|recent|live|health|history|preview|trace|export|forecast|show|catalog|ops)$/i.test(verb)) { return 'read'; }
+    if (/^(delete|remove|clear|cancel|stop|end|forget|revoke|sweep|reset|kill)/i.test(verb)) { return 'destructive'; }
+    if (/^(run|start|rerun|resume|now|fire|test)$/i.test(verb)) { return 'run'; }
+    return 'write';
+}
+
+export function compileManual(
+    src: ManualSource,
+    catalog: readonly CatalogRow[],
+    version: string,
+    now: number = Date.now()
+): ManualBuild {
+    const problems = [...src.problems];
+    const registered = new Set(catalog.map(c => c.op));
+    const ops: ManualOp[] = catalog.map(c => {
+        const m = src.meta[c.op];
+        if (m) {
+            return { op: c.op, describe: c.describe, ...m };
+        }
+        problems.push(`no ops.meta.json entry for ${c.op} (derived)`);
+        return {
+            op: c.op, describe: c.describe, derived: true,
+            area: guessArea(c.op, src.meta), effect: guessEffect(c.op), summary: derivedSummary(c.describe)
+        };
+    }).sort((a, b) => a.op.localeCompare(b.op));
+    for (const name of Object.keys(src.meta)) {
+        if (!registered.has(name)) { problems.push(`ops.meta.json describes ${name}, which is not registered`); }
+    }
+    const areaIds = new Set(src.docs.filter(d => d.kind === 'area').map(d => d.id));
+    for (const o of ops) {
+        if (!areaIds.has(o.area)) { problems.push(`${o.op} is filed under area "${o.area}", which has no guide`); }
+    }
+    for (const d of src.docs) {
+        for (const name of d.ops) {
+            if (!registered.has(name)) { problems.push(`${d.kind} ${d.id} lists op ${name}, which is not registered`); }
+        }
+        if (d.kind === 'playbook' && (!d.area || !areaIds.has(d.area))) {
+            problems.push(`playbook ${d.id} names area "${d.area ?? ''}", which has no guide`);
+        }
+    }
+    return {
+        manual: { schema: MANUAL_SCHEMA, version, builtAt: now, card: src.card, map: src.map, docs: src.docs, ops },
+        problems
+    };
+}
diff --git a/src/core/manualGaps.ts b/src/core/manualGaps.ts
new file mode 100644
index 0000000..4500a4e
--- /dev/null
+++ b/src/core/manualGaps.ts
@@ -0,0 +1,77 @@
+/**
+ * X-536 — WHERE THE MANUAL FAILED AN AGENT, KEPT SO SOMEBODY CAN FIX IT.
+ *
+ * Principle 1 for documentation: a manual that silently fails its readers is
+ * not a manual. Three moments are recorded, locally and nowhere else:
+ * - `unknown-op`  an agent called an op that does not exist (with the names it was offered)
+ * - `weak-find`   farm.find had no confident answer
+ * - `no-guide`    farm.guide was asked for an id that does not exist
+ * af.js appends the same lines from the agent's side (it answers the reads
+ * locally), so both writers share one bounded JSONL file in the bridge folder.
+ * `manual.gaps` reads and clears it; Insights can surface the count.
+ */
+
+import * as fs from 'fs';
+import * as path from 'path';
+
+export const GAPS_FILE = 'manual-gaps.jsonl';
+const KEEP = 500;
+
+export type GapKind = 'unknown-op' | 'weak-find' | 'no-guide';
+
+export interface ManualGap {
+    ts: number;
+    kind: GapKind;
+    what: string;
+    near?: string[];
+    session?: string;
+}
+
+export function gapsPath(bridgeDir: string): string {
+    return path.join(bridgeDir, GAPS_FILE);
+}
+
+export function appendGap(bridgeDir: string, gap: ManualGap): void {
+    const file = gapsPath(bridgeDir);
+    try {
+        fs.mkdirSync(bridgeDir, { recursive: true });
+        fs.appendFileSync(file, JSON.stringify(gap) + '\n', 'utf8');
+        // Trim now and then rather than on every line: an append must stay cheap.
+        const size = fs.statSync(file).size;
+        if (size > 256 * 1024) {
+            const rows = fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).slice(-KEEP);
+            fs.writeFileSync(file, rows.join('\n') + '\n', 'utf8');
+        }
+    } catch { /* a gap that cannot be recorded must never fail the call that found it */ }
+}
+
+export function readGaps(bridgeDir: string, limit = 100): ManualGap[] {
+    let text = '';
+    try { text = fs.readFileSync(gapsPath(bridgeDir), 'utf8'); } catch { return []; }
+    const out: ManualGap[] = [];
+    for (const line of text.split('\n')) {
+        if (!line.trim()) { continue; }
+        try {
+            const g = JSON.parse(line) as ManualGap;
+            if (g && typeof g.what === 'string' && typeof g.kind === 'string') { out.push(g); }
+        } catch { /* a torn line from a concurrent append */ }
+    }
+    return out.slice(-Math.max(1, limit)).reverse();
+}
+
+/** The same question asked many times is one gap with a count. */
+export function summarizeGaps(gaps: readonly ManualGap[]): { kind: GapKind; what: string; count: number; last: number; near?: string[] }[] {
+    const by = new Map<string, { kind: GapKind; what: string; count: number; last: number; near?: string[] }>();
+    for (const g of gaps) {
+        const key = `${g.kind}\u0000${g.what.toLowerCase()}`;
+        const row = by.get(key);
+        if (row) { row.count++; row.last = Math.max(row.last, g.ts); } else {
+            by.set(key, { kind: g.kind, what: g.what, count: 1, last: g.ts, ...(g.near?.length ? { near: g.near } : {}) });
+        }
+    }
+    return [...by.values()].sort((a, b) => b.count - a.count || b.last - a.last);
+}
+
+export function clearGaps(bridgeDir: string): boolean {
+    try { fs.unlinkSync(gapsPath(bridgeDir)); return true; } catch { return false; }
+}
diff --git a/src/core/manualInstall.ts b/src/core/manualInstall.ts
new file mode 100644
index 0000000..b483b8a
--- /dev/null
+++ b/src/core/manualInstall.ts
@@ -0,0 +1,166 @@
+/**
+ * X-536 — TEACH SESSIONS AGENT FARM DOES NOT START: an `agent-farm` skill.
+ *
+ * The start card reaches every session whose engine fires a hook Agent Farm
+ * answers, and every run Agent Farm launches. A session the user opens in a
+ * terminal on an engine with no such hook knows nothing — and a long session
+ * can lose the card to compaction. An Agent Skill closes both gaps: only its
+ * name and description sit in context; the body loads when the conversation
+ * turns to Agent Farm.
+ *
+ * ‼️ CONSENT FIRST. The skill folders are the user's engine configuration, so
+ * `manual.install` PLANS unless confirm=true, and a file without our marker is
+ * never overwritten or removed. Once installed, a skill we wrote is refreshed
+ * on activation when the manual changes, so it never describes an old build.
+ *
+ * ‼️ MEASURED TARGETS ONLY BY DEFAULT. Claude Code (`~/.claude/skills`, which
+ * account slots share and OpenCode also reads) and Codex (`$CODEX_HOME/skills`,
+ * shared the same way) are known from this codebase. Gemini CLI and
+ * Antigravity are listed as unmeasured: they install only when named, and the
+ * table must be re-measured per the engine SOP before they become default.
+ */
+
+import * as fs from 'fs';
+import * as path from 'path';
+import { CompiledManual, renderCard } from '../service/manualQuery';
+
+export const SKILL_NAME = 'agent-farm';
+const MARKER = '<!-- agent-farm:managed';
+
+export interface SkillTarget {
+    engine: string;
+    file: string;
+    measured: boolean;
+    /** another target that already serves this engine */
+    via?: string;
+    note: string;
+}
+
+export function skillTargets(home: string, env: Record<string, string | undefined> = process.env): SkillTarget[] {
+    const codexHome = String(env.CODEX_HOME ?? '').trim() || path.join(home, '.codex');
+    const at = (dir: string) => path.join(dir, SKILL_NAME, 'SKILL.md');
+    return [
+        { engine: 'claude', file: at(path.join(home, '.claude', 'skills')), measured: true,
+            note: 'Claude Code user skills; every captured account shares this folder.' },
+        { engine: 'opencode', file: at(path.join(home, '.claude', 'skills')), measured: true, via: 'claude',
+            note: 'OpenCode loads ~/.claude/skills, so the Claude Code copy serves it.' },
+        { engine: 'codex', file: at(path.join(codexHome, 'skills')), measured: true,
+            note: 'Codex user skills ($CODEX_HOME/skills); every captured account shares this folder.' },
+        { engine: 'gemini', file: at(path.join(home, '.gemini', 'skills')), measured: false,
+            note: 'Gemini CLI user skills. Not yet measured on a real install: named explicitly only.' },
+        { engine: 'agy', file: at(path.join(home, '.gemini', 'antigravity', 'skills')), measured: false,
+            note: 'Antigravity global skills. Not yet measured on a real install: named explicitly only.' }
+    ];
+}
+
+/** The skill as an agent reads it: the card with the portable command, then the map in brief. */
+export function skillText(m: CompiledManual): string {
+    const af = 'node "$HOME/.agentfarm/af.js"';
+    const areas = m.docs.filter(d => d.kind === 'area')
+        .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || a.id.localeCompare(b.id))
+        .map(a => `- **${a.id}**: ${a.summary}`).join('\n');
+    const playbooks = m.docs.filter(d => d.kind === 'playbook')
+        .map(p => `- \`${p.id}\`: ${p.title}`).join('\n');
+    return [
+        '---',
+        `name: ${SKILL_NAME}`,
+        'description: Drive Agent Farm, the VS Code control room for coding agents on this machine. Use it to '
+            + 'start, queue, schedule, trigger, chain, delegate and monitor agent work (tasks, schedules, triggers, '
+            + 'workflows, missions with a lead and a team, baton relays, notices to the user, work queue, projects, '
+            + 'accounts). Use whenever the user asks for something Agent Farm does or mentions agents, tasks, '
+            + 'schedules, missions, relays, notices or the farm.',
+        '---',
+        `${MARKER} version=${m.version}: written by the Agent Farm extension; edits are overwritten. -->`,
+        '',
+        '# Agent Farm',
+        '',
+        renderCard(m.card, { af, version: m.version }),
+        '',
+        'In PowerShell and bash alike the command is `node "$HOME/.agentfarm/af.js" <op>`.',
+        '',
+        '## Areas (`farm.guide id=<area>`)',
+        areas,
+        '',
+        '## Playbooks for common requests (`farm.guide id=<playbook>`)',
+        playbooks,
+        ''
+    ].join('\n');
+}
+
+export type InstallAction = 'create' | 'update' | 'same' | 'via' | 'foreign' | 'unmeasured';
+
+export interface InstallRow { engine: string; file: string; action: InstallAction; note: string }
+
+function readText(file: string): string | undefined {
+    try { return fs.readFileSync(file, 'utf8'); } catch { return undefined; }
+}
+
+export function isManaged(text: string | undefined): boolean {
+    return !!text && text.includes(MARKER);
+}
+
+/** What install would do per target. `engines` names targets; omitted = every measured one. */
+export function planInstall(targets: readonly SkillTarget[], text: string, engines?: readonly string[]): InstallRow[] {
+    const wanted = engines?.length ? new Set(engines.map(e => e.toLowerCase())) : undefined;
+    return targets.filter(t => !wanted || wanted.has(t.engine)).map(t => {
+        if (t.via) { return { engine: t.engine, file: t.file, action: 'via' as const, note: t.note }; }
+        if (!t.measured && !wanted) { return { engine: t.engine, file: t.file, action: 'unmeasured' as const, note: t.note }; }
+        const now = readText(t.file);
+        if (now === undefined) { return { engine: t.engine, file: t.file, action: 'create' as const, note: t.note }; }
+        if (!isManaged(now)) {
+            return { engine: t.engine, file: t.file, action: 'foreign' as const,
+                note: 'A skill of the same name that Agent Farm did not write is there; it is left alone.' };
+        }
+        return { engine: t.engine, file: t.file, action: now === text ? 'same' as const : 'update' as const, note: t.note };
+    });
+}
+
+export function applyInstall(rows: readonly InstallRow[], text: string): string[] {
+    const written: string[] = [];
+    for (const r of rows) {
+        if (r.action !== 'create' && r.action !== 'update') { continue; }
+        fs.mkdirSync(path.dirname(r.file), { recursive: true });
+        fs.writeFileSync(r.file, text, 'utf8');
+        written.push(r.file);
+    }
+    return written;
+}
+
+/** Remove only what we wrote; a foreign skill of the same name is reported and kept. */
+export function removeSkills(targets: readonly SkillTarget[], engines?: readonly string[]): { removed: string[]; kept: string[] } {
+    const wanted = engines?.length ? new Set(engines.map(e => e.toLowerCase())) : undefined;
+    const removed: string[] = [];
+    const kept: string[] = [];
+    const seen = new Set<string>();
+    for (const t of targets) {
+        if ((wanted && !wanted.has(t.engine)) || seen.has(t.file)) { continue; }
+        seen.add(t.file);
+        const now = readText(t.file);
+        if (now === undefined) { continue; }
+        if (!isManaged(now)) { kept.push(t.file); continue; }
+        try {
+            fs.unlinkSync(t.file);
+            try { fs.rmdirSync(path.dirname(t.file)); } catch { /* not empty: the user put something there */ }
+            removed.push(t.file);
+        } catch { kept.push(t.file); }
+    }
+    return { removed, kept };
+}
+
+/** On activation: bring every skill WE installed up to this build. Never installs a new one. */
+export function refreshInstalled(targets: readonly SkillTarget[], text: string): string[] {
+    const rows = targets.filter(t => !t.via && isManaged(readText(t.file)))
+        .map(t => ({ engine: t.engine, file: t.file, action: (readText(t.file) === text ? 'same' : 'update') as InstallAction, note: t.note }));
+    return applyInstall(rows, text);
+}
+
+export function skillStatus(targets: readonly SkillTarget[], text: string): { engine: string; file: string; measured: boolean; installed: boolean; managed: boolean; current: boolean; via?: string }[] {
+    return targets.map(t => {
+        const now = readText(t.file);
+        return {
+            engine: t.engine, file: t.file, measured: t.measured,
+            installed: now !== undefined, managed: isManaged(now), current: now === text,
+            ...(t.via ? { via: t.via } : {})
+        };
+    });
+}
