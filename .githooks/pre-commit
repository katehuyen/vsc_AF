#!/bin/sh
# Encoding guard. package.json has been silently re-encoded twice now (v6.116 and
# again after) by a tool that read it as CP1252 and wrote it back as UTF-8 — a
# version bump was the only intended change both times, and 135 lines of command
# titles came along for the ride. test_encoding.js catches it; this makes running
# it something nobody has to remember.
#
# Installed by "npm install" (the prepare script). To skip once: git commit --no-verify
if ! node test/test_encoding.js >/dev/null 2>&1; then
  echo ""
  echo "COMMIT BLOCKED - mojibake in the working tree."
  node test/test_encoding.js | tail -20
  echo ""
  echo "Repair with:  node test/test_encoding.js --fix"
  echo "Cause: a tool read a UTF-8 file as CP1252 and wrote it back as UTF-8."
  echo "In Windows PowerShell 5.1 that is Get-Content without -Encoding UTF8."
  exit 1
fi

# Right-click catalogue guard. src/core/ctxmenu.ts is the single source of truth
# for every webview context-menu item; a package.json that has drifted from it
# loses menu items without a word (see test/test_ctxmenu.js). Skipped silently
# when out/ has not been built - the test cannot judge what it cannot load.
if [ -f out/core/ctxmenu.js ] && ! node test/test_ctxmenu.js >/dev/null 2>&1; then
  echo ""
  echo "COMMIT BLOCKED - the right-click menus and package.json disagree."
  node test/test_ctxmenu.js | tail -20
  echo ""
  echo "Repair with:  node test/test_ctxmenu.js --fix"
  exit 1
fi

# Credential guard (X-115). Nothing shaped like a real key is committed: the
# STAGED content of every staged text file is searched, and the kind of
# credential is named without printing it. A test that plants one on purpose
# marks it CANARY (tools/credentialShapes.js).
if ! node tools/scan_staged.js; then
  exit 1
fi

# Incident guards (X-468). An assertion written for a real incident is pinned in
# test/pinned.json; deleting, renaming or loosening one stops the commit here,
# with or without a full suite run. It reads the sources, so it needs no build.
if ! node test/test_pinned.js >/dev/null 2>&1; then
  echo ""
  echo "COMMIT BLOCKED - a pinned incident guard is gone or changed."
  node test/test_pinned.js | tail -20
  echo ""
  echo "Removing or loosening a pin needs the user's yes (docs/CONVENTIONS.md, Incident guards are PINNED)."
  exit 1
fi

exit 0
