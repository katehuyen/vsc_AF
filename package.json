{
  "name": "agent-farm",
  "displayName": "Agent Farm",
  "description": "Mission control for your local Claude Code agents: live fleet status, cost analytics, session explorer, health & optimization insights.",
  "version": "0.2.0",
  "publisher": "miropharm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "dashboard",
    "cost",
    "analytics"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFarm",
          "title": "Agent Farm",
          "icon": "media/agentfarm.svg"
        }
      ]
    },
    "views": {
      "agentFarm": [
        {
          "id": "agentfarm.agents",
          "name": "Agents",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.sessions",
          "name": "Recent Sessions",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.insights",
          "name": "Insights",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.feed",
          "name": "Live Feed",
          "icon": "media/agentfarm.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentfarm.agents",
        "contents": "No agents found yet.\n[Add Agent Root Folder](command:agentfarm.addAgentRoot)\nAgent Farm scans the configured root folders for agent directories (folders containing a CLAUDE.md).\n[Open Guide / Kılavuz](command:agentfarm.openGuide)"
      }
    ],
    "commands": [
      {
        "command": "agentfarm.openDashboard",
        "title": "Open Dashboard",
        "category": "Agent Farm",
        "icon": "$(graph)"
      },
      {
        "command": "agentfarm.openGuide",
        "title": "Open Guide (Kılavuz)",
        "category": "Agent Farm",
        "icon": "$(question)"
      },
      {
        "command": "agentfarm.openTimeline",
        "title": "Open Live Timeline",
        "category": "Agent Farm",
        "icon": "$(pulse)"
      },
      {
        "command": "agentfarm.installHooks",
        "title": "Install Live Hooks",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.removeHooks",
        "title": "Remove Live Hooks",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.refresh",
        "title": "Refresh",
        "category": "Agent Farm",
        "icon": "$(refresh)"
      },
      {
        "command": "agentfarm.newAgent",
        "title": "New Agent",
        "category": "Agent Farm",
        "icon": "$(add)"
      },
      {
        "command": "agentfarm.addAgentRoot",
        "title": "Add Agent Root Folder",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.startSession",
        "title": "Start Claude Session",
        "category": "Agent Farm",
        "icon": "$(play)"
      },
      {
        "command": "agentfarm.continueSession",
        "title": "Continue Latest Session",
        "category": "Agent Farm",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentfarm.openAgentDetail",
        "title": "Open Agent Detail",
        "category": "Agent Farm",
        "icon": "$(preview)"
      },
      {
        "command": "agentfarm.openAgentInNewWindow",
        "title": "Open Agent in New Window",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.revealAgent",
        "title": "Reveal in File Explorer",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.openSession",
        "title": "Open Session",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.openFile",
        "title": "Open File",
        "category": "Agent Farm"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentfarm.openDashboard",
          "when": "view == agentfarm.agents",
          "group": "navigation@1"
        },
        {
          "command": "agentfarm.newAgent",
          "when": "view == agentfarm.agents",
          "group": "navigation@2"
        },
        {
          "command": "agentfarm.refresh",
          "when": "view == agentfarm.agents || view == agentfarm.sessions || view == agentfarm.insights || view == agentfarm.feed",
          "group": "navigation@3"
        },
        {
          "command": "agentfarm.openTimeline",
          "when": "view == agentfarm.feed",
          "group": "navigation@1"
        },
        {
          "command": "agentfarm.openGuide",
          "when": "view == agentfarm.agents",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agentfarm.startSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.openAgentDetail",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.startSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@1"
        },
        {
          "command": "agentfarm.continueSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@2"
        },
        {
          "command": "agentfarm.openAgentDetail",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@3"
        },
        {
          "command": "agentfarm.openAgentInNewWindow",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "2_open@1"
        },
        {
          "command": "agentfarm.revealAgent",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "2_open@2"
        }
      ]
    },
    "configuration": {
      "title": "Agent Farm",
      "properties": {
        "agentFarm.agentRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "D:/zone/agent/ajanlar"
          ],
          "description": "Root folders scanned for agent directories (a folder containing CLAUDE.md is treated as an agent)."
        },
        "agentFarm.claudeDir": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code data directory. Leave empty to use ~/.claude."
        },
        "agentFarm.activeThresholdSeconds": {
          "type": "number",
          "default": 150,
          "description": "A session is considered ACTIVE if its transcript changed within this many seconds."
        },
        "agentFarm.staleMemoryDays": {
          "type": "number",
          "default": 45,
          "description": "Memory files untouched for more than this many days are flagged as stale."
        },
        "agentFarm.contextBudgetTokens": {
          "type": "number",
          "default": 8000,
          "description": "Warn when an agent's fixed context load (CLAUDE.md + MEMORY.md + AGENTS.md) exceeds this estimated token budget."
        },
        "agentFarm.windowTokenLimit": {
          "type": "number",
          "default": 0,
          "description": "Optional token limit for the rolling 5-hour usage window (subscription plans). 0 hides the progress bar and shows raw totals."
        },
        "agentFarm.maxTranscriptMessages": {
          "type": "number",
          "default": 400,
          "description": "Maximum number of messages rendered in the session viewer."
        },
        "agentFarm.liveMonitor": {
          "type": "boolean",
          "default": true,
          "description": "Run the local live-event listener (127.0.0.1) that receives Claude Code hook events."
        },
        "agentFarm.livePort": {
          "type": "number",
          "default": 8377,
          "description": "Port for the local live-event listener. Re-run 'Install Live Hooks' after changing it."
        },
        "agentFarm.stuckThresholdSeconds": {
          "type": "number",
          "default": 240,
          "description": "A working session with no hook events for this long is marked STALLED."
        },
        "agentFarm.notifyPermission": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent is waiting for a permission approval."
        },
        "agentFarm.notifyStuck": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent looks stalled."
        },
        "agentFarm.notifyTurnEnd": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification every time an agent finishes its turn."
        },
        "agentFarm.includeUnmatchedProjects": {
          "type": "boolean",
          "default": false,
          "description": "Also include Claude Code sessions whose working directory is outside the configured agent roots (shown under 'Other projects')."
        },
        "agentFarm.pricing": {
          "type": "array",
          "description": "Model pricing rules in USD per million tokens. First regex match wins.",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string"
              },
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              }
            }
          },
          "default": [
            {
              "match": "opus",
              "input": 15,
              "output": 75,
              "cacheWrite": 18.75,
              "cacheRead": 1.5
            },
            {
              "match": "fable|mythos",
              "input": 15,
              "output": 75,
              "cacheWrite": 18.75,
              "cacheRead": 1.5
            },
            {
              "match": "sonnet",
              "input": 3,
              "output": 15,
              "cacheWrite": 3.75,
              "cacheRead": 0.3
            },
            {
              "match": "haiku",
              "input": 1,
              "output": 5,
              "cacheWrite": 1.25,
              "cacheRead": 0.1
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
