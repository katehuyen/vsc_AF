        "icon": "$(play)"
      },
      {
        "command": "agentfarm.deleteSchedule",
        "title": "Delete Schedule",
        "category": "Agent Farm",
        "icon": "$(trash)"
      },
      {
        "command": "agentfarm.revealTaskTerminal",
        "title": "Reveal Task Terminal",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.saveTaskTemplate",
        "title": "Save as Template",
        "category": "Agent Farm"
      },
      {
        "command": "agentfarm.runTemplate",
