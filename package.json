{
  "name": "agent-farm",
  "displayName": "Agent Farm",
  "description": "Mission control for your local Claude Code agents: live fleet status, cost analytics, session explorer, health & optimization insights.",
  "version": "0.7.0",
  "icon": "media/icon.png",
  "publisher": "miropharm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "dashboard",
    "cost",
    "analytics"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFarm",
          "title": "Agent Farm",
          "icon": "media/agentfarm.svg"
        }
      ]
    },
    "views": {
      "agentFarm": [
        {
          "id": "agentfarm.agents",
          "name": "Agents",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.tasks",
          "name": "Tasks",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.sessions",
          "name": "Recent Sessions",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.insights",
          "name": "Insights",
          "icon": "media/agentfarm.svg"
        },
        {
          "id": "agentfarm.feed",
          "name": "Live Feed",
          "icon": "media/agentfarm.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentfarm.agents",
        "contents": "No agents found yet.\n[Add Agent Root Folder](command:agentfarm.addAgentRoot)\nAgent Farm scans the configured root folders for agent directories (folders containing a CLAUDE.md).\n[Open Guide / Kılavuz](command:agentfarm.openGuide)"
      },
      {
        "view": "agentfarm.tasks",
        "contents": "Queue work for your agents and schedule recurring runs.\n[Add Task](command:agentfarm.addTask)\n[Add Scheduled Task](command:agentfarm.addSchedule)\nTasks open a terminal in the agent's folder and run claude with your prompt.\n[Open Guide / Kılavuz](command:agentfarm.openGuide)"
      }
    ],
    "commands": [
