    "menus": {
      "view/title": [
        {
          "command": "agentfarm.openDashboard",
          "when": "view == agentfarm.agents",
          "group": "navigation@1"
        },
        {
          "command": "agentfarm.newAgent",
          "when": "view == agentfarm.agents",
          "group": "navigation@2"
        },
        {
          "command": "agentfarm.refresh",
          "when": "view == agentfarm.agents || view == agentfarm.sessions || view == agentfarm.insights || view == agentfarm.feed",
          "group": "navigation@3"
        },
        {
          "command": "agentfarm.openTimeline",
          "when": "view == agentfarm.feed",
          "group": "navigation@1"
        },
        {
          "command": "agentfarm.addTask",
          "when": "view == agentfarm.tasks",
          "group": "navigation@1"
        },
        {
          "command": "agentfarm.addSchedule",
          "when": "view == agentfarm.tasks",
          "group": "navigation@2"
        },
        {
          "command": "agentfarm.newWorkflow",
          "when": "view == agentfarm.tasks",
          "group": "navigation@3"
        },
        {
          "command": "agentfarm.clearDoneTasks",
          "when": "view == agentfarm.tasks",
          "group": "overflow@1"
        },
        {
          "command": "agentfarm.refresh",
          "when": "view == agentfarm.tasks",
          "group": "navigation@4"
        },
        {
          "command": "agentfarm.openGuide",
          "when": "view == agentfarm.agents",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agentfarm.startSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.openAgentDetail",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.startSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@1"
        },
        {
          "command": "agentfarm.continueSession",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@2"
        },
        {
          "command": "agentfarm.openAgentDetail",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@3"
        },
        {
          "command": "agentfarm.openAgentInNewWindow",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "2_open@1"
        },
        {
          "command": "agentfarm.revealAgent",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "2_open@2"
        },
        {
          "command": "agentfarm.addDuty",
          "when": "view == agentfarm.agents && viewItem == duties-section",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.addDuty",
          "when": "view == agentfarm.agents && viewItem == agent",
          "group": "1_actions@4"
        },
        {
          "command": "agentfarm.toggleDuty",
          "when": "view == agentfarm.agents && viewItem =~ /duty-(active|paused)/",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.deleteDuty",
          "when": "view == agentfarm.agents && viewItem =~ /duty-(active|paused)/",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.openDuties",
          "when": "view == agentfarm.agents && viewItem =~ /duty-(active|paused)|duties-section/",
          "group": "1_duty@1"
        },
        {
          "command": "agentfarm.startTask",
          "when": "view == agentfarm.tasks && viewItem == task-queued",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.taskUp",
          "when": "view == agentfarm.tasks && viewItem == task-queued",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.taskDown",
          "when": "view == agentfarm.tasks && viewItem == task-queued",
          "group": "inline@3"
        },
        {
          "command": "agentfarm.completeTask",
          "when": "view == agentfarm.tasks && viewItem == task-running",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.deleteTask",
          "when": "view == agentfarm.tasks && viewItem == task-final",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.startTask",
          "when": "view == agentfarm.tasks && viewItem == task-queued",
          "group": "1_task@1"
        },
        {
          "command": "agentfarm.cancelTask",
          "when": "view == agentfarm.tasks && viewItem =~ /task-(queued|running)/",
          "group": "1_task@2"
        },
        {
          "command": "agentfarm.completeTask",
          "when": "view == agentfarm.tasks && viewItem == task-running",
          "group": "1_task@3"
        },
        {
          "command": "agentfarm.deleteTask",
          "when": "view == agentfarm.tasks && viewItem =~ /task-(queued|final)/",
          "group": "1_task@4"
        },
        {
          "command": "agentfarm.runScheduleNow",
          "when": "view == agentfarm.tasks && viewItem =~ /schedule-(on|off)/",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.deleteSchedule",
          "when": "view == agentfarm.tasks && viewItem =~ /schedule-(on|off)/",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.toggleSchedule",
          "when": "view == agentfarm.tasks && viewItem =~ /schedule-(on|off)/",
          "group": "1_sched@1"
        },
        {
          "command": "agentfarm.exportSchtask",
          "when": "view == agentfarm.tasks && viewItem =~ /schedule-(on|off)/",
          "group": "1_sched@2"
        },
        {
          "command": "agentfarm.openTaskOutput",
          "when": "view == agentfarm.tasks && viewItem =~ /task-(final|running)/",
          "group": "1_task@0"
        },
        {
          "command": "agentfarm.saveTaskTemplate",
          "when": "view == agentfarm.tasks && viewItem =~ /task-/",
          "group": "2_extra@1"
        },
        {
          "command": "agentfarm.runTemplate",
          "when": "view == agentfarm.tasks && viewItem == template",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.deleteTemplate",
          "when": "view == agentfarm.tasks && viewItem == template",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.runWorkflow",
          "when": "view == agentfarm.tasks && viewItem == workflow",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.addWorkflowStep",
          "when": "view == agentfarm.tasks && viewItem == workflow",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.deleteWorkflow",
          "when": "view == agentfarm.tasks && viewItem == workflow",
          "group": "inline@3"
        },
        {
          "command": "agentfarm.renameWorkflow",
          "when": "view == agentfarm.tasks && viewItem == workflow",
          "group": "1_wf@1"
        },
        {
          "command": "agentfarm.editWorkflowStep",
          "when": "view == agentfarm.tasks && viewItem == workflow-step",
          "group": "inline@1"
        },
        {
          "command": "agentfarm.moveWorkflowStepUp",
          "when": "view == agentfarm.tasks && viewItem == workflow-step",
          "group": "inline@2"
        },
        {
          "command": "agentfarm.moveWorkflowStepDown",
          "when": "view == agentfarm.tasks && viewItem == workflow-step",
          "group": "inline@3"
        },
        {
          "command": "agentfarm.deleteWorkflowStep",
          "when": "view == agentfarm.tasks && viewItem == workflow-step",
          "group": "1_step@1"
        }
      ]
    },
    "configuration": {
      "title": "Agent Farm",
      "properties": {
        "agentFarm.agentRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "D:/zone/agent/ajanlar"
          ],
          "description": "Root folders scanned for agent directories (a folder containing CLAUDE.md is treated as an agent)."
        },
        "agentFarm.claudeDir": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code data directory. Leave empty to use ~/.claude."
        },
        "agentFarm.activeThresholdSeconds": {
          "type": "number",
          "default": 150,
          "description": "A session is considered ACTIVE if its transcript changed within this many seconds."
        },
        "agentFarm.staleMemoryDays": {
          "type": "number",
          "default": 45,
          "description": "Memory files untouched for more than this many days are flagged as stale."
        },
        "agentFarm.contextBudgetTokens": {
          "type": "number",
          "default": 8000,
          "description": "Warn when an agent's fixed context load (CLAUDE.md + MEMORY.md + AGENTS.md) exceeds this estimated token budget."
        },
        "agentFarm.windowTokenLimit": {
          "type": "number",
          "default": 0,
          "description": "Optional token limit for the rolling 5-hour usage window (subscription plans). 0 hides the progress bar and shows raw totals."
        },
        "agentFarm.maxTranscriptMessages": {
          "type": "number",
          "default": 400,
          "description": "Maximum number of messages rendered in the session viewer."
        },
        "agentFarm.liveMonitor": {
          "type": "boolean",
          "default": true,
          "description": "Run the local live-event listener (127.0.0.1) that receives Claude Code hook events."
        },
        "agentFarm.livePort": {
          "type": "number",
          "default": 8377,
          "description": "Port for the local live-event listener. Re-run 'Install Live Hooks' after changing it."
        },
        "agentFarm.stuckThresholdSeconds": {
          "type": "number",
          "default": 240,
          "description": "A working session with no hook events for this long is marked STALLED."
        },
        "agentFarm.notifyPermission": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent is waiting for a permission approval."
        },
        "agentFarm.notifyStuck": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent looks stalled."
        },
        "agentFarm.notifyTurnEnd": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification every time an agent finishes its turn."
        },
        "agentFarm.queueAutoAdvance": {
          "type": "boolean",
          "default": false,
          "description": "When a task finishes (its terminal closes), automatically start the next queued task for that agent."
        },
        "agentFarm.autoReport": {
          "type": "string",
          "enum": ["off", "daily", "weekly"],
          "default": "off",
          "description": "Automatically write a fleet report into autoReportFolder (checked hourly while VS Code is open)."
        },
        "agentFarm.autoReportFolder": {
          "type": "string",
          "default": "",
          "description": "Folder for automatic fleet reports (e.g. a folder inside your Obsidian vault)."
        },
        "agentFarm.autoReportDays": {
          "type": "number",
          "default": 7,
          "description": "Period (in days) covered by automatic fleet reports."
        },
        "agentFarm.trendAlertFactor": {
          "type": "number",
          "default": 2,
          "description": "Warn when an agent's 7-day cost reaches this multiple of the previous 7 days. 0 disables trend alerts."
        },
        "agentFarm.autoReportIncludeOutputs": {
          "type": "boolean",
          "default": true,
          "description": "Append the archived task-outputs digest to automatic fleet reports."
        },
        "agentFarm.budgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "description": "Daily USD budgets by agent name (API-equivalent value). Use \"*\" for a fleet-wide budget. Example: {\"psikolog\": 20, \"*\": 50}. Warns at 80%, alerts when exceeded."
        },
        "agentFarm.includeUnmatchedProjects": {
          "type": "boolean",
          "default": false,
          "description": "Also include Claude Code sessions whose working directory is outside the configured agent roots (shown under 'Other projects')."
        },
        "agentFarm.pricing": {
          "type": "array",
          "description": "Model pricing rules in USD per million tokens. First regex match wins.",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string"
              },
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              }
            }
          },
          "default": [
            {
              "match": "opus",
              "input": 15,
              "output": 75,
              "cacheWrite": 18.75,
              "cacheRead": 1.5
            },
            {
              "match": "fable|mythos",
              "input": 15,
              "output": 75,
              "cacheWrite": 18.75,
              "cacheRead": 1.5
            },
            {
              "match": "sonnet",
              "input": 3,
              "output": 15,
              "cacheWrite": 3.75,
              "cacheRead": 0.3
            },
            {
              "match": "haiku",
              "input": 1,
              "output": 5,
              "cacheWrite": 1.25,
              "cacheRead": 0.1
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
