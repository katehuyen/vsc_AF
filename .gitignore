node_modules/
out/
.vscode-test/
# what test/render_page.js and test/shoot_page.js draw — a looking glass, not a
# record. The fixtures ARE kept (test/fixtures/); the pictures are regenerated.
dist/render/
# what tools/opencode_acp_probe.js captures — raw wire logs of a real engine
# session, the same kind of looking glass. The MEASUREMENT is kept (the tables in
# docs/OPENCODE-ENTEGRASYON.tr.md and the fixtures inside test/test_opencode.js);
# the megabytes of frames it was cut from are regenerated by running the probe.
dist/measure/
par.out

# Scratch a session writes and does not keep: the commit message it feeds to
# `git commit -F`, and the one-shot bridge payloads. The reusable tools in
# .tmp/ (bridge.js, cut.js, the *-post.js recipes) stay tracked on purpose.
.tmp/msg.txt
.tmp/payload*.json
