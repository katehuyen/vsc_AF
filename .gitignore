node_modules/
out/
.vscode-test/
# what test/render_page.js and test/shoot_page.js draw — a looking glass, not a
# record. The fixtures ARE kept (test/fixtures/); the pictures are regenerated.
dist/render/
# what tools/opencode_acp_probe.js captures — raw wire logs of a real engine
# session, the same kind of looking glass. The MEASUREMENT is kept (the tables in
# docs/OPENCODE-ENTEGRASYON.tr.md and the fixtures inside test/test_opencode.js);
# the megabytes of frames it was cut from are regenerated by running the probe.
dist/measure/
par.out

# Scratch a session writes and does not keep: the commit message it feeds to
# `git commit -F`, the one-shot bridge payloads, a dumped catalog. The reusable
# tools in .tmp/ (bridge.js, cut.js, quota.js, the *-post.js recipes) stay
# tracked on purpose.
#
# The rule is by KIND, not by name. It used to list `.tmp/msg.txt` and
# `.tmp/payload*.json` literally, which meant a session that called its message
# file anything else - `commitmsg.txt` - put its own scratch in the commit and
# had to be told so as a trap. Scratch is anything here that is not a tool.
.tmp/*
!.tmp/*.js
# same rule, the other scratch folder a session may reach for. The reusable
# bridge/measurement tools live in .tmp/ and are the ones that are kept.
scratchpad/
